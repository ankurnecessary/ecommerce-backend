{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm watch-openapi\" \"pnpm dev:server\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:debug": "dotenv -- nodemon --watch src --ext ts,json --signal SIGTERM --exec \"sh -lc 'test -n \\\"\\$PORT_DEBUG\\\" || { echo PORT_DEBUG is not set in .env; exit 1; }; node --inspect=0.0.0.0:\\$PORT_DEBUG --import tsx src/server.ts'\"",
    "dev:docker": "sed -i \"s/^NODE_VERSION=.*/NODE_VERSION=$(cat .nvmrc)/\" .env && pnpm openapi && docker compose up --build",
    "dev:docker:debug": "SERVER_COMMAND=\"pnpm dev:debug\" pnpm dev:docker",
    "build": "tsc && node scripts/rewrite-dist-aliases.mjs",
    "start": "node dist/server.js",
    "build:start": "pnpm build && node ./dist/server.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "lint": "eslint \"src/**/*.{js,ts}\"",
    "prod:create": "sh ./shell-scripts/prod-create.sh",
    "prod:update": "sh ./shell-scripts/prod-update.sh",
    "openapi": "tsx scripts/swagger/generate-openapi",
    "validate-openapi": "pnpm exec redocly lint openapi.yaml",
    "validate-openapi:local": "pnpm exec redocly lint openapi.yaml --skip-rule no-server-example.com",
    "watch-openapi": "nodemon --watch src --ext ts,json --exec pnpm openapi",
    "static-api-doc": "pnpm exec redocly build-docs openapi.yaml -o docs/index.html",
    "reset:db": "prisma migrate reset && pnpm prisma db seed"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@redocly/cli": "^2.19.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.11",
    "@types/pg": "^8.16.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitest/coverage-v8": "^4.0.18",
    "ajv": "^8.17.1",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^6.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "nodemon": "^3.1.10",
    "prettier": "^3.4.2",
    "prisma": "^7.4.0",
    "resolve": "^1.22.10",
    "swagger-jsdoc": "^6.2.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "serverless-http": "^3.2.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  }
}
